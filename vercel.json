{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/wholesale/",
      "destination": "/consignment-stockists/",
      "permanent": true
    },
    {
      "source": "/pieces/mulberry-corduroy-hat/",
      "destination": "/pieces/deep-burgundy-corduroy-hat/",
      "permanent": true
    },
    {
      "source": "/pieces/ochre-cotton-twill-hat/",
      "destination": "/pieces/cornflower-cotton-twill-hat/",
      "permanent": true
    },
    {
      "source": "/pieces/moss-corduroy-hat/",
      "destination": "/pieces/dusty-lilac-corduroy-hat/",
      "permanent": true
    },
    {
      "source": "/pieces/oat-cotton-hat/",
      "destination": "/pieces/buttercream-cotton-hat/",
      "permanent": true
    }
  ]
}
