NODE_ENV=development
APP_URL=http://localhost:4371
# Optional local-only catalog preview: load public photos from the live site.
# Accepted only in development when APP_URL is localhost.
# LOCAL_CATALOG_MEDIA_ORIGIN=https://goodapollogoods.com
DATABASE_URL=postgresql://good_apollo:CHANGE_ME@localhost:5432/good_apollo_dev
DIRECT_DATABASE_URL=postgresql://good_apollo:CHANGE_ME@localhost:5432/good_apollo_dev
BETTER_AUTH_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTE_SECRET
QUOTE_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTE_SECRET
CRON_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTE_SECRET
ADMIN_EMAIL=hello@annakahrs.com
# Optional comma-separated extra operators. Keep empty when testing access is removed.
ADDITIONAL_ADMIN_EMAILS=
SUPPORT_EMAIL=hello@goodapollogoods.com
SALES_ENABLED=false
STRIPE_LIVE_MODE_APPROVED=false
STRIPE_SECRET_KEY=
# Dedicated Good Apollo endpoint secret, never Vesper's endpoint secret.
STRIPE_WEBHOOK_SECRET=
AWS_REGION=us-east-1
S3_BUCKET=good-apollo-local
MEDIA_BUDGET_BYTES=4294967296
S3_ENDPOINT=http://localhost:19000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=local-development
AWS_SECRET_ACCESS_KEY=local-development-only
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Good Apollo Goods <hello@annakahrs.com>
# Production uses the private Good Apollo commerce mail gateway.
COMMERCE_EMAIL_API_URL=
COMMERCE_EMAIL_HMAC_SECRET=
LOCAL_MAIL=true
NEWSLETTER_ENABLED=false
NEWSLETTER_CONFIRMATION_DISPATCH_ENABLED=false
# Set only when confirmation emails use an alternate HTTPS website origin.
# NEWSLETTER_CONFIRMATION_ORIGIN=https://review.example.com
# Private server-to-server origin; keep newsletter feature disabled until Infra confirms dispatch.
NEWSLETTER_API_URL=
# Use a unique 32+ character secret per protected environment; never expose it to browser code.
NEWSLETTER_HMAC_SECRET=
