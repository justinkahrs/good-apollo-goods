{
  "name": "good-apollo-goods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4371",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:local": "GAG_LOCAL_RUNTIME=true npm run build",
    "start:local": "ASTRO_NODE_AUTOSTART=enabled HOST=127.0.0.1 PORT=4371 node --env-file=.env dist/server/entry.mjs",
    "local:setup": "tsx scripts/setup-local.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "precheck": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.11",
    "@astrojs/node": "11.1.6",
    "@astrojs/vercel": "11.0.18",
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/s3-presigned-post": "3.1138.0",
    "@aws-sdk/s3-request-presigner": "3.1138.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.5",
    "better-auth": "1.7.16",
    "dotenv": "17.2.3",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "stripe": "22.6.2",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.16.0",
    "@types/qrcode": "1.5.6",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "fast-uri": "4.2.3",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
