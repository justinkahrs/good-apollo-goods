---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Collection from '../components/Collection.astro';
import OurStory from '../components/OurStory.astro';
import { products } from '../data/products';

const heroImage = products[0].images[0];
---
<Layout title="Good Apollo Goods — Handmade hats in Grand Rapids" description="Small-batch child and adult hats, handmade in Grand Rapids, Michigan from cotton, cotton twill, and corduroy.">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">One maker · Grand Rapids, Michigan</p>
      <h1 id="hero-title">Hats made with<br /><em>character.</em><br />Made to last.</h1>
      <p class="hero-description">Thoughtfully constructed child and adult hats in cotton, cotton twill, and corduroy. Designed slowly and sewn in small batches.</p>
      <div class="hero-actions"><Button href="/shop/" arrow>Shop all hats</Button><a href="/sizing-care/" class="text-link">Find your size <span aria-hidden="true">↗</span></a></div>
      <p class="hero-footnote">Cotton lined · Small batch · Handmade one at a time</p>
    </div>
    <div class="hero-textile"><Image class="hero-image" src={heroImage.src} alt={heroImage.alt} widths={[600, 900, 1200]} sizes="(max-width: 800px) 90vw, 48vw" width={1200} height={1500} fit="cover" format="webp" loading="eager" fetchpriority="high" /><div class="maker-seal"><span>SMALL BATCH</span><strong>made<br /><em>here.</em></strong><span>GRAND RAPIDS</span></div></div>
  </section>
  <div class="values-strip container"><span>Natural fibers</span><span aria-hidden="true">✳︎</span><span>Child & adult sizing</span><span aria-hidden="true">✳︎</span><span>Made by one pair of hands</span></div>
  <Collection compact />
  <OurStory />
  <section class="retail-callout container" aria-labelledby="retail-title"><p class="eyebrow">For independent shops</p><h2 id="retail-title" class="display-heading">A small label with room to grow.</h2><p>Good Apollo Goods is open to thoughtful consignment and retail partnerships with independent shops.</p><Button href="/consignment-stockists/" variant="secondary" arrow>For shops & stockists</Button></section>
</Layout>
<style>
  .hero { display: grid; grid-template-columns: 1fr 1.08fr; gap: clamp(2rem, 6vw, 6rem); padding-top: var(--space-6); padding-bottom: var(--space-16); align-items: center; }
  .hero-copy { padding-block: var(--space-10); }
  .hero h1 { font-size: var(--text-hero); line-height: 1.01; margin-top: var(--space-6); font-weight: 430; text-wrap: balance; }
  .hero h1 em { color: var(--color-brand); font-weight: 420; }
  .hero-description { color: var(--color-muted); max-width: 38ch; margin-top: var(--space-6); margin-bottom: var(--space-8); font-size: var(--text-base); line-height: 1.75; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-5) var(--space-8); }
  .hero-footnote { font-size: var(--text-xs); color: var(--color-muted); margin-top: var(--space-6); }
  .hero-textile { position: relative; min-width: 0; aspect-ratio: 4 / 5; border-radius: 46% 46% var(--radius-sm) var(--radius-sm); background: var(--color-cream-200); overflow: hidden; }
  .hero-textile :global(.hero-image) { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
  .maker-seal { position: absolute; bottom: 2.5rem; left: 1.5rem; width: 132px; height: 132px; border-radius: 50%; background: var(--color-accent); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .45rem; transform: rotate(-10deg); }
  .maker-seal span { font-size: .56rem; font-weight: 650; letter-spacing: .14em; }
  .maker-seal strong { font-family: var(--font-display); font-size: 2rem; line-height: .87; text-align: center; font-weight: 500; }
  .values-strip { display: flex; align-items: center; justify-content: space-around; gap: var(--space-4); padding-block: var(--space-6); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); font-size: var(--text-sm); }
  .values-strip [aria-hidden] { color: var(--color-brand); font-size: 1.4rem; }
  .retail-callout { padding-block: var(--space-section); display: grid; grid-template-columns: 1fr 1.2fr auto; align-items: end; gap: var(--space-8); border-top: 1px solid var(--color-border); }
  .retail-callout p:not(.eyebrow) { color: var(--color-muted); max-width: 42ch; }
  @media(max-width: 900px) { .retail-callout { grid-template-columns: 1fr; align-items: start; } }
  @media(max-width: 800px) { .hero { grid-template-columns: 1fr; gap: var(--space-8); padding-top: 0; } .hero-copy { padding-block: var(--space-6); } .hero h1 { font-size: clamp(3.15rem, 11vw, 5rem); } .hero-textile { margin-left: var(--space-4); } .maker-seal { width: 112px; height: 112px; left: 1rem; bottom: 1.5rem; } .values-strip { flex-wrap: wrap; justify-content: center; gap: var(--space-3) var(--space-6); } .values-strip span:last-child,.values-strip [aria-hidden]:nth-child(4) { display: none; } }
</style>
