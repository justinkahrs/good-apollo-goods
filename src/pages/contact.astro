---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Contact — Good Apollo Goods" description="Contact the maker behind Good Apollo Goods.">
  <PageHero eyebrow="Contact" title="Send a note to the studio." intro="Questions about sizing, a piece, an order, or carrying Good Apollo Goods in your shop are always welcome." />
  <section class="container contact-card">
    <div class="contact-copy"><span class="eyebrow">Email</span><a href="mailto:hello@goodapollogoods.com">hello@goodapollogoods.com</a><p>Good Apollo Goods is a one-woman studio, so replies come directly from the maker. Please allow a little time around production days.</p></div>
    <form class="contact-form" action="mailto:hello@goodapollogoods.com" method="post" enctype="text/plain" data-contact-form>
      <div class="form-row"><div class="field"><label for="contact-name">Name</label><input id="contact-name" name="name" type="text" autocomplete="name" required /></div><div class="field"><label for="contact-email">Email</label><input id="contact-email" name="email" type="email" autocomplete="email" required /></div></div>
      <div class="field"><label for="contact-subject">Subject <span>(optional)</span></label><input id="contact-subject" name="subject" type="text" /></div>
      <div class="field"><label for="contact-message">Message</label><textarea id="contact-message" name="message" rows="6" required></textarea></div>
      <div><button class="button button--primary" type="submit">Send a message <span aria-hidden="true">↗</span></button><p class="form-note">Submitting opens a ready-to-send email draft.</p><p class="form-status" data-contact-status aria-live="polite"></p></div>
    </form>
  </section>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-contact-status]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const value = (field: string) => String(data.get(field) ?? '').trim();
    const name = value('name');
    const email = value('email');
    const subject = value('subject') || `Message from ${name}`;
    const message = value('message');
    const body = `Name: ${name}\nEmail: ${email}\n\n${message}`;
    window.location.href = `mailto:hello@goodapollogoods.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    if (status) status.textContent = 'A ready-to-send email draft is opening.';
  });
</script>
<style>
  .contact-card { padding-block: var(--space-section); display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(3rem, 9vw, 9rem); align-items: start; }
  .contact-copy { display: grid; gap: var(--space-5); }
  .contact-copy a { width: fit-content; font-family: var(--font-display); font-size: var(--text-2xl); text-decoration-thickness: 1px; text-underline-offset: 6px; overflow-wrap: anywhere; }
  .contact-copy p { color: var(--color-muted); max-width: 36ch; line-height: 1.8; margin-top: var(--space-3); }
  .contact-form { display: grid; gap: var(--space-6); padding: clamp(1.5rem, 4vw, 3rem); background: var(--color-surface); border-radius: var(--radius-md); }
  .form-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .field { display: grid; gap: var(--space-2); }
  .field label { font-size: var(--text-sm); font-weight: 600; }
  .field label span { color: var(--color-muted); font-weight: 400; }
  input,textarea { width: 100%; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: var(--space-3); background: var(--color-page); color: var(--color-text); font: inherit; }
  textarea { min-height: 9rem; resize: vertical; }
  .form-note,.form-status { color: var(--color-muted); font-size: var(--text-xs); line-height: 1.6; }
  .form-note { margin-top: var(--space-4); }
  .form-status { min-height: 1.6em; margin-top: var(--space-2); }
  @media(max-width: 700px) { .contact-card { grid-template-columns: 1fr; } }
  @media(max-width: 480px) { .form-row { grid-template-columns: 1fr; } }
</style>
