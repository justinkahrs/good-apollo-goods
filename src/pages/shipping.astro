---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Shipping — Good Apollo Goods" description="Shipping information for Good Apollo Goods hats.">
  <PageHero eyebrow="Help / Shipping" title="From the studio to you." intro="Every order ships from the Good Apollo Goods studio in Grand Rapids, Michigan." />
  <section class="container info-grid"><h2>What to expect</h2><div><h3>Ready-to-ship pieces</h3><p>Good Apollo Goods is released in small batches. Ready-to-ship status appears on the product page, and final processing and delivery estimates will be shown at checkout.</p><h3>Rates and tracking</h3><p>Available services, shipping rates, and tracking details will be confirmed during checkout.</p></div></section>
</Layout>
