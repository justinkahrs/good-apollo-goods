---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
---
<Layout title="Consignment & Stockists — Good Apollo Goods" description="Consignment and retail partnerships for handmade child and adult hats from Good Apollo Goods in Grand Rapids, Michigan.">
  <PageHero eyebrow="For independent shops" title="Consignment & stockists." intro="If your shop values useful pieces with a strong point of view, I would be glad to talk. Good Apollo Goods is a small, independently made label, and every retail partnership begins with a direct conversation." />

  <section class="container partner-intro" aria-labelledby="partner-intro-title">
    <div class="partner-mark" aria-hidden="true"><span>ONE MAKER</span><strong>made<br /><em>in small runs.</em></strong><span>GRAND RAPIDS · MICHIGAN</span></div>
    <div class="partner-copy">
      <p class="eyebrow">A considered assortment</p>
      <h2 id="partner-intro-title">Handmade pieces for independent shelves.</h2>
      <p>The current collection centers on child and adult hats, cut and sewn one at a time in Grand Rapids. Quantities stay intentionally limited so construction and finish never become an afterthought.</p>
      <p>Some pieces may be ready to place; others can be made in a small run. Colors, fabrics, sizes, and timing will vary with studio capacity and material availability.</p>
    </div>
  </section>

  <section class="product-notes" aria-labelledby="product-notes-title">
    <div class="container notes-heading"><p class="eyebrow">The collection</p><h2 id="product-notes-title">What shops can expect.</h2></div>
    <div class="container notes-grid">
      <article><span>01</span><h3>Pieces</h3><p>Small-batch child and adult hats in a focused range of colors and fabrics. Available styles and quantities may change from one run to the next.</p></article>
      <article><span>02</span><h3>Materials</h3><p>Hats are primarily made from cotton, cotton twill, and corduroy, with a soft cotton lining. Exact materials are listed with each piece.</p></article>
      <article><span>03</span><h3>Sizing</h3><p>Child and adult sizing are kept separate. Letter sizes are paired with actual head circumference so staff and customers can choose fit clearly.</p><a href="/sizing-care/">View the size guide <span aria-hidden="true">↗</span></a></article>
      <article><span>04</span><h3>Care</h3><p>Machine wash cold on a gentle cycle, air dry only, and reshape while damp if needed. High heat should be avoided.</p></article>
    </div>
  </section>

  <section class="partnership" aria-labelledby="partnership-title">
    <div class="container partnership-layout">
      <div class="partnership-heading"><p class="eyebrow">How it works</p><h2 id="partnership-title">Personal, clear, and sized to the shop.</h2><p>There is no one-size-fits-all program. We can talk through consignment or another small retail arrangement and decide what makes sense for both sides.</p></div>
      <ol class="partnership-steps">
        <li><span>01</span><div><h3>Start with your shop.</h3><p>Tell me a little about your store, your customers, and the kinds of pieces you are interested in carrying.</p></div></li>
        <li><span>02</span><div><h3>Review the current work.</h3><p>I will share what is available, possible sizes and colors, and when the next completed small batch is expected.</p></div></li>
        <li><span>03</span><div><h3>Agree on a small first step.</h3><p>Before pieces change hands, we will put the assortment, timing, pricing, payment, and consignment or retail details in writing.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="container inquiry" aria-labelledby="inquiry-title">
    <p class="eyebrow">Retail inquiries</p>
    <h2 id="inquiry-title">Interested in carrying Good Apollo Goods?</h2>
    <p>Send a note with your shop name, location, website or social link, and what caught your eye. You will hear directly from the maker.</p>
    <div class="inquiry-actions"><Button href="mailto:hello@goodapollogoods.com?subject=Consignment%20%2F%20stockist%20inquiry" arrow>Start an inquiry</Button><a class="text-link" href="/contact/">Contact details <span aria-hidden="true">↗</span></a></div>
  </section>
</Layout>

<style>
  .partner-intro { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(3rem, 9vw, 9rem); align-items: center; padding-block: var(--space-section); }
  .partner-mark { min-height: 500px; background: var(--color-accent); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-6); padding: var(--space-8); text-align: center; border-radius: 48% 48% var(--radius-sm) var(--radius-sm); transform: rotate(-1deg); }
  .partner-mark span { font-size: var(--text-xs); font-weight: 650; letter-spacing: .16em; }
  .partner-mark strong { font-family: var(--font-display); font-size: clamp(3rem, 6.5vw, 5.25rem); line-height: .9; font-weight: 500; }
  .partner-copy { max-width: 62ch; }
  .partner-copy h2 { margin-block: var(--space-5) var(--space-8); font-size: var(--text-3xl); }
  .partner-copy p:not(.eyebrow) { color: var(--color-muted); line-height: 1.85; margin-top: var(--space-5); }
  .product-notes { padding-block: var(--space-section); background: var(--color-surface); }
  .notes-heading { display: grid; grid-template-columns: .65fr 1.35fr; gap: var(--space-8); align-items: end; margin-bottom: var(--space-12); }
  .notes-heading h2 { font-size: var(--text-3xl); }
  .notes-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--color-border); }
  .notes-grid article { position: relative; min-height: 290px; padding: var(--space-10) clamp(1.5rem, 4vw, 4rem) var(--space-10) 0; border-bottom: 1px solid var(--color-border); }
  .notes-grid article:nth-child(odd) { border-right: 1px solid var(--color-border); }
  .notes-grid article:nth-child(even) { padding-left: clamp(1.5rem, 4vw, 4rem); }
  .notes-grid article > span { color: var(--color-brand); font-size: var(--text-xs); font-weight: 650; letter-spacing: .12em; }
  .notes-grid h3 { margin-block: var(--space-5) var(--space-4); font-size: var(--text-2xl); }
  .notes-grid p { max-width: 55ch; color: var(--color-muted); line-height: 1.8; }
  .notes-grid a { display: inline-flex; gap: var(--space-5); margin-top: var(--space-6); font-size: var(--text-sm); text-underline-offset: 5px; }
  .partnership { padding-block: var(--space-section); background: var(--color-brand); color: var(--color-page); }
  .partnership-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 9vw, 9rem); }
  .partnership-heading .eyebrow { color: var(--color-accent); }
  .partnership-heading h2 { margin-block: var(--space-5) var(--space-6); font-size: var(--text-3xl); }
  .partnership-heading > p:last-child { max-width: 48ch; color: rgb(229 227 200 / .76); line-height: 1.8; }
  .partnership-steps { list-style: none; padding: 0; margin: 0; border-top: 1px solid rgb(229 227 200 / .28); }
  .partnership-steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--space-5); padding-block: var(--space-8); border-bottom: 1px solid rgb(229 227 200 / .28); }
  .partnership-steps li > span { padding-top: .25rem; color: var(--color-accent); font-size: var(--text-xs); font-weight: 650; letter-spacing: .12em; }
  .partnership-steps h3 { font-size: var(--text-xl); }
  .partnership-steps p { max-width: 56ch; margin-top: var(--space-3); color: rgb(229 227 200 / .76); line-height: 1.75; }
  .inquiry { padding-block: var(--space-section); text-align: center; }
  .inquiry h2 { max-width: 18ch; margin: var(--space-5) auto var(--space-6); font-size: var(--text-3xl); }
  .inquiry > p:not(.eyebrow) { max-width: 58ch; margin-inline: auto; color: var(--color-muted); line-height: 1.8; }
  .inquiry-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-5) var(--space-8); margin-top: var(--space-8); }
  @media(max-width: 850px) { .partner-intro,.partnership-layout { grid-template-columns: 1fr; } .partner-mark { min-height: 400px; max-width: 500px; } .notes-heading { grid-template-columns: 1fr; } }
  @media(max-width: 650px) { .notes-grid { grid-template-columns: 1fr; } .notes-grid article:nth-child(odd) { border-right: 0; } .notes-grid article:nth-child(even) { padding-left: 0; } .notes-grid article { min-height: 0; padding-right: 0; } }
</style>
