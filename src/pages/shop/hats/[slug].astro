---
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { publicCatalog } from '../../../server/catalog';
import { money } from '../../../server/domain';
import { db } from '../../../server/db';
import { salesReady, discoveryEnabled } from '../../../server/config';
export const prerender = false;
const products = await publicCatalog();
const product = products.find((p) => p.slug === Astro.params.slug);
if (!product || product.category !== 'hat') return Astro.redirect('/404/', 404);
const related = products
  .filter((p) => p.slug !== product.slug && p.category === product.category)
  .slice(0, 2);
const settings = await db().storeSettings.findUnique({
  where: { id: 'store' },
});
const available = product.variants.some((v) => v.available > 0);
const singlePiece = product.variants.length === 1;
const price = Math.min(...product.variants.map((v) => v.priceCents));
const categoryLabel = 'Hats';
const categoryHref = '/shop/hats/';
const structured = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  image: product.images.map((i) => new URL(i.url, Astro.site).href),
  offers: product.variants.map((v) => ({
    '@type': 'Offer',
    priceCurrency: 'USD',
    price: (v.priceCents / 100).toFixed(2),
    availability:
      v.available > 0
        ? 'https://schema.org/InStock'
        : 'https://schema.org/OutOfStock',
    url: new URL(Astro.url.pathname, Astro.site).href,
  })),
};
---

<Layout
  title={`${product.name} — Good Apollo Goods`}
  description={product.description}
>
  {discoveryEnabled() && (
    <script
      is:inline
      slot="head"
      type="application/ld+json"
      set:html={JSON.stringify(structured).replaceAll('<', '\\u003c')}
    />
  )}
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/shop/">Shop</a>
      <span aria-hidden="true">/</span>
      <a href={categoryHref}>{categoryLabel}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{product.name}</span>
    </nav>
  </div>
  <section class="container product-grid" aria-labelledby="product-title">
    <div
      class:list={['product-gallery', { single: product.images.length === 1 }]}
      data-product-gallery
      aria-label="Product photos"
      role="region"
      aria-roledescription="carousel"
    >
      <div class="gallery-stage">
        {product.images.map((image, index) => (
          <figure
            data-gallery-slide
            hidden={index !== 0}
            data-variant-photo={image.variantId ?? ''}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${product.images.length}`}
          >
            <img
              src={image.url}
              srcset={image.srcset}
              sizes="(max-width:850px) 92vw, 48vw"
              alt={image.alt}
              width="1200"
              height="1200"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'low'}
            />
          </figure>
        ))}
        {product.images.length > 1 && (
          <div
            class="gallery-dots"
            data-gallery-navigation
            hidden
            role="group"
            aria-label="Choose a photo"
          >
            {product.images.map((_, index) => (
              <button
                type="button"
                class="gallery-dot"
                data-gallery-dot={index}
                aria-label={`Show photo ${index + 1}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <span class="sr-only">Photo {index + 1}</span>
              </button>
            ))}
          </div>
        )}
      </div>
      <p class="sr-only" data-gallery-status aria-live="polite"></p>
    </div>
    <div class="product-copy">
      <h1 id="product-title">{product.name}</h1>
      <p class="product-price" data-piece-price>
        {money(price)}
      </p>
      <p class="product-description">{product.description}</p>
      <form class="purchase-form" data-add-to-cart>
        {singlePiece ? (
          <input type="hidden" name="variant" value={product.variants[0].id} />
        ) : (
          <div class="variant-select">
            <fieldset>
              <legend>Size</legend>
              <div class="variant-options">
                {product.variants.map((v) => (
                  <label class="variant-option">
                    <input
                      type="radio"
                      name="variant"
                      value={v.id}
                      data-price={v.priceCents}
                      disabled={v.available === 0}
                      required
                    />
                    <span>
                      {v.label}{v.available === 0 ? ' · Sold out' : ''}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
            <a href="/sizing-care/">Size guide</a>
          </div>
        )}
        <button
          class="button button--primary add-button"
          type="submit"
          disabled={!available || !salesReady()}
        >
          {salesReady()
            ? available
              ? 'Add to cart'
              : 'Sold out'
            : 'Collection opening soon'}
        </button>
        <p class="cart-status" data-cart-status aria-live="polite"></p>
        <a href="/cart/">View cart</a>
      </form>
      <dl class="product-facts">
        {product.detail && (
          <div>
            <dt>Size & details</dt>
            <dd>{product.detail}</dd>
          </div>
        )}
        <div>
          <dt>Materials</dt>
          <dd>{product.materials}</dd>
        </div>
        <div>
          <dt>Availability</dt>
          <dd>{available ? 'Ready to ship' : 'Sold out'}</dd>
        </div>
      </dl>
      <div class="practical-details">
        <div>
          <h2>Care</h2>
          <p>
            {product.care ||
              'Please contact us for care guidance for this piece.'}
          </p>
        </div>
        <div>
          <h2>Shipping & final sale</h2>
          <p>
            U.S. shipping {money(settings?.shippingCents ?? 695)} per order,
            including Alaska and Hawaii. Processing:{' '}
            {settings?.processingWindow ?? '3–5 business days'}. Shipping and
            applicable tax are confirmed before payment. All sales are final.
            For an incorrect, damaged or missing order, contact us so we can
            review it. See <a href="/shipping/">shipping</a> and the{' '}
            <a href="/returns/">final sale policy</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
  {related.length > 0 && (
    <section class="container related">
      <div class="related-heading">
        <h2 class="display-heading">More {categoryLabel.toLowerCase()}.</h2>
        <a href={categoryHref} class="text-link">
          Shop {categoryLabel.toLowerCase()}
        </a>
      </div>
      <div class="related-grid">
        {related.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </section>
  )}
</Layout>
<script>
  import { addPiece } from '../../../client/cart';
  import { initProductGallery } from '../../../client/product-gallery';
  const form = document.querySelector<HTMLFormElement>('[data-add-to-cart]'),
    status = document.querySelector<HTMLElement>('[data-cart-status]');
  initProductGallery(
    document.querySelector<HTMLElement>('[data-product-gallery]'),
    form,
  );
  form?.addEventListener('change', () => {
    const selected = form.querySelector<HTMLInputElement>(
      'input[name="variant"]:checked',
    );
    const price = document.querySelector('[data-piece-price]');
    if (selected?.dataset.price && price)
      price.textContent = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
      }).format(Number(selected.dataset.price) / 100);
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const id = String(new FormData(form).get('variant') ?? '');
    if (!id) return;
    try {
      addPiece(id);
      if (status) status.textContent = 'Added to your cart.';
    } catch (error) {
      if (status) status.textContent = (error as Error).message;
    }
  });
</script>
<style>
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-transform: capitalize;
  }
  .breadcrumb a {
    text-underline-offset: 4px;
  }
  .product-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
    padding-bottom: var(--space-section);
  }
  .product-gallery {
    display: block;
  }
  .product-gallery [hidden] {
    display: none;
  }
  .product-gallery[data-gallery-ready] {
    display: block;
  }
  .product-gallery.single {
    grid-template-columns: 1fr;
  }
  .gallery-stage {
    touch-action: pan-y;
    position: relative;
  }
  .product-gallery figure {
    margin: 0;
    min-width: 0;
  }
  .product-gallery[data-gallery-ready] figure {
    display: none;
  }
  .product-gallery[data-gallery-ready] figure[data-gallery-active] {
    display: block;
  }
  .product-gallery figure:first-child {
    grid-column: 1 / -1;
  }
  .product-gallery img {
    width: 100%;
    display: block;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center bottom;
    background: transparent;
    border-radius: 0;
  }
  .gallery-dots {
    position: absolute;
    inset: auto 0 var(--space-3);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }
  .gallery-dot {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .gallery-dot::after {
    content: '';
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--color-brand);
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 0 1px white;
  }
  .gallery-dot[aria-pressed='true']::after {
    background: var(--color-brand);
  }
  .gallery-dot:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -4px;
    border-radius: 50%;
  }
  .product-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    background: var(--color-secondary);
    border-radius: var(--radius-md);
  }
  .placeholder-mark {
    width: min(52%, 20rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-page) 28%, transparent);
  }
  .placeholder-mark img {
    width: 58%;
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    background: none;
    border-radius: 0;
    opacity: 0.42;
  }
  .product-gallery figcaption {
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-top: var(--space-3);
  }
  .product-copy {
    position: sticky;
    top: var(--space-6);
  }
  .product-copy h1 {
    font-size: var(--text-3xl);
    margin-top: var(--space-5);
    text-wrap: balance;
  }
  .product-price {
    font-size: var(--text-xl);
    margin-top: var(--space-5);
    font-variant-numeric: tabular-nums;
  }
  .product-description {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.45;
    margin-top: var(--space-8);
  }
  .product-detail {
    color: var(--color-muted);
    margin-top: var(--space-5);
    line-height: 1.8;
  }
  .purchase-form {
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }
  .unlisted-note {
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted);
    line-height: 1.8;
  }
  .variant-select {
    margin-bottom: var(--space-6);
  }
  .variant-select fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .variant-select legend {
    display: block;
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .variant-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .variant-option {
    position: relative;
    cursor: pointer;
  }
  .variant-option input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .variant-option span {
    display: grid;
    min-width: 48px;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    background: var(--color-page);
    font: inherit;
    place-items: center;
  }
  .variant-option input:checked + span {
    border-color: var(--color-brand);
    color: var(--color-page);
    background: var(--color-brand);
  }
  .variant-option input:focus-visible + span {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .variant-option input:disabled + span {
    color: var(--color-muted);
    background: var(--color-surface);
    text-decoration: line-through;
  }
  .variant-option:has(input:disabled) {
    cursor: not-allowed;
  }
  .variant-select > a {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-underline-offset: 4px;
  }
  .add-button {
    width: 100%;
  }
  .cart-status {
    min-height: 1.4em;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .cart-status :global(a) {
    color: var(--color-text);
    text-underline-offset: 4px;
  }
  .product-facts {
    margin: 0;
  }
  .product-facts div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .product-facts dt {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .product-facts dd {
    margin: 0;
    font-size: var(--text-sm);
  }
  .product-facts small {
    color: var(--color-muted);
  }
  .practical-details {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-8);
  }
  .practical-details h2 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0;
    font-weight: 650;
    margin-bottom: var(--space-2);
  }
  .practical-details p {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.75;
  }
  .practical-details a {
    color: var(--color-text);
    text-underline-offset: 4px;
  }
  .related {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-section);
  }
  .related-heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: baseline;
    margin-bottom: var(--space-10);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    max-width: 900px;
  }
  @media (max-width: 850px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
    .product-copy {
      position: static;
    }
  }
  @media (max-width: 650px) {
    .related-heading {
      display: block;
    }
    .related-heading a {
      margin-top: var(--space-5);
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
