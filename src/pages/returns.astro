import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Returns & exchanges — Good Apollo Goods" description="Returns and exchanges information for Good Apollo Goods.">
  <PageHero eyebrow="Help / Returns & exchanges" title="Let’s find a good resolution." intro="Because each hat is made in a small batch, careful measuring is the best first step. If something is not right, please get in touch." />
  <section class="container info-grid"><h2>Before you order</h2><div><h3>Check the size guide</h3><p>Measure around the head where the hat will naturally sit and compare that number with the separate Child or Adult chart.</p><h3>Keep the piece unworn</h3><p>Return eligibility and timing will be confirmed before checkout opens. Unworn, unwashed pieces in original condition will be the starting point.</p><h3>Questions about an order</h3><p>Email <a href="mailto:hello@goodapollogoods.com">hello@goodapollogoods.com</a> with your order details so the maker can help directly.</p></div></section>
</Layout>
