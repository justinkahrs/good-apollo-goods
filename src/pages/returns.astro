---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Final sale policy — Good Apollo Goods"
  description="Final sale policy and ordering guidance for Good Apollo Goods."
>
  <PageHero
    eyebrow="Help / Final sale policy"
    title="Please check the details before ordering."
    intro="Every Good Apollo piece is final sale. Small-batch production is a meaningful investment for a tiny business, so routine returns, exchanges, repairs, and refunds are not available."
  />
  <section class="container info-grid">
    <h2>Before you order</h2>
    <div>
      <h3>Double-, triple-, and quadruple-check the details</h3>
      <p>
        Please review the product measurements, materials, color, care, and full
        description before placing your order. For pieces that do not require a
        fit measurement, check the listed dimensions, materials, and intended
        use to be sure they are right for you.
      </p>
      <h3>Questions first, please</h3>
      <p>
        If anything is unclear, email{' '}
        <a href="mailto:hello@goodapollogoods.com">hello@goodapollogoods.com</a>{' '}
        before ordering. I’m happy to help with the details so you can feel good
        about your choice.
      </p>
      <h3>All sales are final</h3>
      <p>
        The studio does not accept routine returns, exchanges or repair
        requests. Please choose carefully before payment.
      </p>
      <h3>An order problem?</h3>
      <p>
        If your order is incorrect, damaged or missing, email
        <a href="mailto:hello@goodapollogoods.com">hello@goodapollogoods.com</a>
        from the address used at checkout with your order number and details.
        The studio will review the problem. This does not create a general
        return or exchange policy.
      </p>
    </div>
  </section>
</Layout>
