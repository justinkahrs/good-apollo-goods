---
const destination = '/consignment-stockists/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <title>Consignment & Stockists — Good Apollo Goods</title>
  </head>
  <body>
    <p>This page has moved to <a href={destination}>Consignment & Stockists</a>.</p>
    <script is:inline define:vars={{ destination }}>window.location.replace(destination);</script>
  </body>
</html>
