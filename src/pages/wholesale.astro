---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Wholesale & Retail Partnerships — Good Apollo Goods" description="Wholesale inquiries for handmade child and adult hats from Good Apollo Goods in Grand Rapids, Michigan.">
  <PageHero eyebrow="Wholesale" title="Wholesale & retail partnerships." intro="Good Apollo Goods is open to working with independent retailers and boutiques that value thoughtful design and well-made goods." />
  <section class="container wholesale-grid">
    <div class="wholesale-note"><span>HANDMADE</span><strong>small<br /><em>batches.</em></strong><span>GRAND RAPIDS</span></div>
    <div class="wholesale-copy"><h2>A growing collection, made with care.</h2><p>The current collection centers on handmade child and adult hats produced in small batches in Grand Rapids, Michigan.</p><p>The wholesale program is still developing. A catalog, pricing, order minimums, and detailed terms will be added as the collection grows.</p><p>If Good Apollo Goods feels right for your shop, wholesale inquiries are welcome.</p><a class="button button--primary" href="mailto:hello@goodapollogoods.com?subject=Wholesale%20inquiry">Start a wholesale inquiry <span aria-hidden="true">↗</span></a></div>
  </section>
</Layout>
<style>
  .wholesale-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(3rem, 9vw, 9rem); align-items: center; padding-block: var(--space-section); }
  .wholesale-note { min-height: 480px; background: var(--color-accent); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-6); text-align: center; border-radius: 48% 48% var(--radius-sm) var(--radius-sm); transform: rotate(-1deg); }
  .wholesale-note span { font-size: var(--text-xs); font-weight: 650; letter-spacing: .16em; }
  .wholesale-note strong { font-family: var(--font-display); font-size: clamp(3rem, 7vw, 5.5rem); line-height: .9; font-weight: 500; }
  .wholesale-copy { max-width: 60ch; }
  .wholesale-copy h2 { font-size: var(--text-3xl); margin-bottom: var(--space-8); }
  .wholesale-copy p { color: var(--color-muted); margin-bottom: var(--space-5); line-height: 1.85; }
  .wholesale-copy :global(.button) { margin-top: var(--space-4); }
  @media(max-width: 800px) { .wholesale-grid { grid-template-columns: 1fr; } .wholesale-note { min-height: 400px; max-width: 480px; } }
</style>
