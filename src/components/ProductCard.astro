---
import type { PublicProduct } from '../server/catalog';
import { money } from '../server/domain';
interface Props {
  product: PublicProduct;
}
const { product } = Astro.props;
const primaryImage = product.images[0];
const available = product.variants.some((v) => v.available > 0);
const price = Math.min(...product.variants.map((v) => v.priceCents));
const audience =
  product.audience === 'all'
    ? 'For everyone'
    : product.audience === 'child'
      ? 'For children'
      : 'For adults';
---

<article class="product-card" data-category={product.category}>
  <a href={`/pieces/${product.slug}/`} class="product-link">
    <div class="product-photo">
      {primaryImage && (
        <img
          src={primaryImage.url}
          srcset={primaryImage.srcset}
          alt={primaryImage.alt}
          sizes="(max-width: 700px) 90vw, 45vw"
          width="800"
          height="1000"
          loading="lazy"
        />
      )}
      <span class="badge">{available ? 'Ready to ship' : 'Sold out'}</span>
      <span class="product-arrow" aria-hidden="true">
        ↗
      </span>
    </div>
    <div class="product-meta">
      <div class="product-title-row">
        <h3>{product.name}</h3>
        <span class="product-price">
          {product.variants.some((v) => v.priceCents !== price) ? 'From ' : ''}
          {money(price)}
        </span>
      </div>
      <div class="product-detail-row">
        <span>{audience}</span>
        <span>{product.materials}</span>
      </div>
    </div>
  </a>
</article>
<style>
  .product-link {
    display: block;
    text-decoration: none;
  }
  .product-photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .product-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform var(--duration-gentle) var(--ease-out),
      filter var(--duration-gentle);
  }
  .product-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: var(--color-secondary);
  }
  .placeholder-mark {
    width: min(58%, 13rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-page) 28%, transparent);
  }
  .placeholder-mark img {
    width: 58%;
    height: auto;
    opacity: 0.42;
  }
  .product-photo .badge {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
  }
  .product-arrow {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-4);
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    background: var(--color-page);
    border-radius: var(--radius-pill);
    transition:
      background var(--duration-fast),
      transform var(--duration-fast);
  }
  .product-link:hover .product-photo img {
    transform: scale(1.025);
    filter: saturate(1.04);
  }
  .product-link:hover .product-arrow {
    background: var(--color-accent);
    transform: rotate(5deg);
  }
  .product-meta {
    padding-top: var(--space-5);
  }
  .product-title-row,
  .product-detail-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    align-items: baseline;
  }
  .product-title-row h3 {
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    letter-spacing: -0.035em;
  }
  .product-price {
    font-size: var(--text-base);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .product-detail-row {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
    flex-wrap: wrap;
    gap: 0 var(--space-2);
  }
  @media (max-width: 500px) {
    .product-detail-row span:last-child {
      display: none;
    }
  }
</style>
