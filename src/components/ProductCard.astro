---
import { Image } from 'astro:assets';
import { formatPrice, type Product } from '../data/products';
interface Props { product: Product; }
const { product } = Astro.props;
const primaryImage = product.images[0];
---
<article class="product-card" data-category={product.kind}>
  <a href={`/pieces/${product.slug}/`} class="product-link">
    <div class="product-photo">
      {product.isListed ? <Image src={primaryImage.src} alt={primaryImage.alt} widths={[360, 540, 800]} sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 30vw" width={800} height={1000} fit="cover" format="webp" loading="lazy" style={{ objectPosition: primaryImage.position ?? 'center' }} /> : <div class="product-placeholder" aria-hidden="true"><div class="placeholder-mark"><img src="/brand/gag-stacked-lockup.svg" alt="" /></div></div>}
      {product.isListed && <><span class="badge">{product.status}</span><span class="product-arrow" aria-hidden="true">↗</span></>}
    </div>
    <div class="product-meta">
      <div class="product-title-row"><h3>{product.name}</h3>{product.isListed && <span class="product-price">{formatPrice(product.price)}</span>}</div>
      <div class="product-detail-row"><span>{product.color}</span><span>{product.lining}</span></div>
    </div>
  </a>
</article>
<style>
  .product-link { display: block; text-decoration: none; }
  .product-photo { position: relative; overflow: hidden; aspect-ratio: 4 / 5; border-radius: var(--radius-md); background: var(--color-surface); }
  .product-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--duration-gentle) var(--ease-out), filter var(--duration-gentle); }
  .product-placeholder { width: 100%; height: 100%; display: grid; place-items: center; background: var(--color-secondary); }
  .placeholder-mark { width: min(58%, 13rem); aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--color-page) 28%, transparent); }
  .placeholder-mark img { width: 58%; height: auto; opacity: .42; }
  .product-photo .badge { position: absolute; top: var(--space-4); left: var(--space-4); }
  .product-arrow { position: absolute; bottom: var(--space-4); right: var(--space-4); display: grid; place-items: center; width: 42px; height: 42px; background: var(--color-page); border-radius: var(--radius-pill); transition: background var(--duration-fast), transform var(--duration-fast); }
  .product-link:hover .product-photo img { transform: scale(1.025); filter: saturate(1.04); }
  .product-link:hover .product-arrow { background: var(--color-accent); transform: rotate(5deg); }
  .product-meta { padding-top: var(--space-5); }
  .product-title-row,.product-detail-row { display: flex; justify-content: space-between; gap: var(--space-3); align-items: baseline; }
  .product-title-row h3 { font-size: clamp(1.35rem, 2vw, 1.65rem); letter-spacing: -.035em; }
  .product-price { font-size: var(--text-base); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .product-detail-row { margin-top: var(--space-2); font-size: var(--text-xs); color: var(--color-muted); flex-wrap: wrap; gap: 0 var(--space-2); }
  @media(max-width: 500px) { .product-detail-row span:last-child { display: none; } }
</style>
