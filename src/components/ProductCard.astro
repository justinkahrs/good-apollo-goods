---
import { Image } from 'astro:assets';
import { formatPrice, type Product } from '../data/products';
interface Props { product: Product; }
const { product } = Astro.props;
const primaryImage = product.images[0];
const formattedPrice = typeof product.price === 'number' && product.status !== 'Coming Soon' ? formatPrice(product.price) : null;
const state = product.status.toLowerCase().replaceAll(' ', '-');
---
<article class="product-card" data-category={product.audience}>
  <a href={`/pieces/${product.slug}/`} class="product-link">
    <div class:list={['product-photo', { 'is-placeholder': primaryImage.placeholder }]}>
      <Image src={primaryImage.src} alt={primaryImage.alt} widths={[360, 540, 800]} sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 30vw" width={800} height={1000} fit="cover" format="webp" loading="lazy" style={{ objectPosition: primaryImage.position ?? 'center' }} />
      <span class="badge" data-state={state}>{product.status}</span>
      <span class="product-arrow" aria-hidden="true">↗</span>
    </div>
    <div class="product-meta">
      <p class="product-audience">{product.audience} hats</p>
      <div class="product-title-row"><h3>{product.name}</h3>{formattedPrice && <span class="product-price">{formattedPrice}</span>}</div>
      <div class="product-detail-row"><span>{product.color}</span><span>{product.lining}</span></div>
    </div>
  </a>
</article>
<style>
  .product-link { display: block; text-decoration: none; }
  .product-photo { position: relative; overflow: hidden; aspect-ratio: 4 / 5; border: 1px solid var(--color-brand); border-radius: var(--radius-md); background: var(--color-surface-strong); }
  .product-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--duration-gentle) var(--ease-out), filter var(--duration-gentle); }
  .product-photo.is-placeholder img { opacity: .82; mix-blend-mode: multiply; }
  .product-photo .badge { position: absolute; top: var(--space-4); left: var(--space-4); }
  .product-arrow { position: absolute; bottom: var(--space-4); right: var(--space-4); display: grid; place-items: center; width: 42px; height: 42px; background: var(--color-secondary); border: 1px solid var(--color-brand); border-radius: var(--radius-pill); transition: background var(--duration-fast), transform var(--duration-fast); }
  .product-link:hover .product-photo img { transform: scale(1.025); filter: saturate(1.04); }
  .product-link:hover .product-arrow { background: var(--color-page); transform: rotate(5deg); }
  .product-meta { padding-top: var(--space-5); }
  .product-audience { color: var(--color-muted); font-size: var(--text-xs); margin-bottom: var(--space-2); text-transform: capitalize; }
  .product-title-row,.product-detail-row { display: flex; justify-content: space-between; gap: var(--space-3); align-items: baseline; }
  .product-title-row h3 { font-size: clamp(1.35rem, 2vw, 1.65rem); letter-spacing: -.035em; }
  .product-price { font-size: var(--text-base); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .product-detail-row { margin-top: var(--space-2); font-size: var(--text-xs); color: var(--color-muted); flex-wrap: wrap; gap: 0 var(--space-2); }
  @media(max-width: 500px) { .product-detail-row span:last-child { display: none; } }
</style>
