---
import { Image } from 'astro:assets';
import { formatPrice, type Product } from '../data/products';
interface Props { product: Product; }
const { product } = Astro.props;
---
<article class="product-card" data-category={product.category}>
  <a href={`/pieces/${product.slug}/`} class="product-link">
    <div class="product-photo">
      <Image src={product.image} alt={product.imageAlt} widths={[360, 540, 800]} sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 30vw" width={800} height={960} fit="cover" format="webp" loading="lazy" style={{ objectPosition: product.imagePosition ?? 'center' }} />
      <span class="badge">Sample piece</span>
      <span class="product-arrow" aria-hidden="true">↗</span>
    </div>
    <div class="product-meta"><p class="product-craft">{product.craft}</p><div class="product-title-row"><h3>{product.name}</h3><span class="product-price">{formatPrice(product.samplePrice)}</span></div><div class="product-detail-row"><span>{product.color}</span><span>Sample price · USD</span></div></div>
  </a>
</article>
<style>
  .product-link { display: block; text-decoration: none; }
  .product-photo { position: relative; overflow: hidden; aspect-ratio: 4 / 4.6; border-radius: var(--radius-md); background: var(--color-surface); }
  .product-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--duration-gentle) var(--ease-out); }
  .product-photo .badge { position: absolute; top: var(--space-4); left: var(--space-4); }
  .product-arrow { position: absolute; bottom: var(--space-4); right: var(--space-4); display: grid; place-items: center; width: 40px; height: 40px; background: var(--color-page); border-radius: var(--radius-pill); transition: background var(--duration-fast), transform var(--duration-fast); }
  .product-link:hover .product-photo img { transform: scale(1.035); }
  .product-link:hover .product-arrow { background: var(--color-accent); transform: rotate(5deg); }
  .product-meta { padding-top: var(--space-5); }
  .product-craft { color: var(--color-muted); font-size: var(--text-xs); margin-bottom: var(--space-2); }
  .product-title-row,.product-detail-row { display: flex; justify-content: space-between; gap: var(--space-3); align-items: baseline; }
  .product-title-row h3 { font-size: clamp(1.35rem, 2vw, 1.65rem); letter-spacing: -.035em; }
  .product-price { font-size: var(--text-base); white-space: nowrap; }
  .product-detail-row { margin-top: var(--space-2); font-size: var(--text-xs); color: var(--color-muted); flex-wrap: wrap; gap: 0 var(--space-2); }
</style>
