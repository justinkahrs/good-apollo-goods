---
import Brand from './Brand.astro';
---
<div class="announcement">A few good things are on their way. <a href="/#collection">Take a little peek <span aria-hidden="true">↗</span></a></div>
<header class="container site-header">
  <nav aria-label="Main navigation" class="primary-nav">
    <a href="/#collection">The collection</a>
    <a href="/#our-story">Our story</a>
  </nav>
  <Brand />
  <a class="opening-link" href="/#opening"><span class="status-dot" aria-hidden="true"></span>Shop opening soon <span aria-hidden="true">↗</span></a>
</header>
<style>
  .announcement { background: var(--color-brand); color: var(--color-page); text-align: center; font-size: var(--text-xs); padding: .6rem var(--space-4); }
  .announcement a:focus-visible { outline-color: var(--color-focus-inverse); }
  .primary-nav { display: flex; align-items: center; gap: var(--space-8); }
  .announcement a { margin-left: .35rem; text-underline-offset: 3px; }
  .site-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 118px; gap: var(--space-6); }
  .primary-nav a,.opening-link { text-decoration: none; font-size: var(--text-sm); }
  .primary-nav a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .opening-link { justify-self: end; display: flex; align-items: center; gap: var(--space-3); }
  .status-dot { height: 6px; width: 6px; background: var(--color-olive-700); border-radius: 50%; }
  @media(max-width: 800px) {
    .site-header { grid-template-columns: 1fr auto; min-height: 100px; }
    .primary-nav { grid-row: 2; grid-column: 1 / -1; justify-content: center; padding-bottom: var(--space-5); }
    .site-header :global(.brand) { grid-column: 1; grid-row: 1; margin-top: var(--space-5); }
    .opening-link { grid-column: 2; grid-row: 1; margin-top: var(--space-5); font-size: var(--text-xs); }
  }
  @media(max-width: 420px) { .opening-link .status-dot { display: none; } .opening-link { gap: var(--space-2); } .site-header :global(.brand-name) { font-size: 2rem; } }
</style>
