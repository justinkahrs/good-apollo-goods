---
import Brand from './Brand.astro';

const pathname = Astro.url.pathname;
const navigation = [
  { label: 'Shop', href: '/shop/' },
  { label: 'About', href: '/about/' },
  { label: 'Sizing & Care', href: '/sizing-care/' },
  { label: 'Consignment / Stockists', href: '/consignment-stockists/' },
  { label: 'Contact', href: '/contact/' },
];
const isActive = (href: string) => pathname === href || pathname.startsWith(href) || (href === '/shop/' && pathname.startsWith('/pieces/'));
---
<div class="announcement">Handmade in Grand Rapids, Michigan <span aria-hidden="true">·</span> Small batches, one maker</div>
<header class="container site-header">
  <Brand />
  <div class="header-actions">
    <a class="cart-link" href="/cart/" aria-current={pathname === '/cart/' ? 'page' : undefined}>Cart <span aria-hidden="true">(</span><span data-cart-count>0</span><span aria-hidden="true">)</span></a>
    <button class="menu-trigger" type="button" aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" data-menu-open>
      <span>Menu</span>
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<dialog id="site-menu" class="site-menu" aria-label="Site navigation" data-site-menu>
  <div class="menu-shell">
    <header class="container menu-header">
      <div class="menu-brand"><Brand /></div>
      <button class="menu-close" type="button" data-menu-close>
        <span>Close</span>
        <span class="close-icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </header>
    <div class="container menu-body">
      <div class="menu-context">
        <p class="eyebrow">Good Apollo Goods</p>
        <p>Small-batch hats,<br />made in Grand Rapids.</p>
      </div>
      <nav class="menu-nav" aria-label="Primary navigation">
        {navigation.map((item, index) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span class="menu-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="menu-label">{item.label}</span>
            <span class="menu-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
      <div class="menu-meta">
        <a href="/cart/">Cart (<span data-cart-count>0</span>)</a>
        <a href="https://www.instagram.com/goodapollogoods/" target="_blank" rel="noopener noreferrer">Instagram <span class="sr-only">(opens in a new tab)</span></a>
        <p>One woman making useful, characterful pieces by hand.</p>
      </div>
    </div>
  </div>
</dialog>

<script>
  const menuDialog = document.querySelector<HTMLDialogElement>('[data-site-menu]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  let closeTimer: number | undefined;

  const finishClose = () => {
    if (!menuDialog) return;
    menuDialog.close();
    menuDialog.classList.remove('is-closing');
    document.documentElement.classList.remove('menu-open');
    openButton?.setAttribute('aria-expanded', 'false');
    openButton?.focus();
  };

  const closeMenu = () => {
    if (!menuDialog?.open || menuDialog.classList.contains('is-closing')) return;
    menuDialog.classList.add('is-closing');
    openButton?.setAttribute('aria-expanded', 'false');
    window.clearTimeout(closeTimer);
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) finishClose();
    else closeTimer = window.setTimeout(finishClose, 360);
  };

  openButton?.addEventListener('click', () => {
    if (!menuDialog || menuDialog.open) return;
    menuDialog.showModal();
    document.documentElement.classList.add('menu-open');
    openButton.setAttribute('aria-expanded', 'true');
    closeButton?.focus();
  });
  closeButton?.addEventListener('click', closeMenu);
  menuDialog?.addEventListener('cancel', (event) => { event.preventDefault(); closeMenu(); });
</script>

<script>
  const updateCartCount = () => {
    let count = 0;
    try {
      const cart = JSON.parse(localStorage.getItem('good-apollo-cart') ?? '[]');
      count = Array.isArray(cart) ? cart.reduce((total, item) => total + (Number(item.quantity) || 0), 0) : 0;
    } catch { count = 0; }
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((element) => { element.textContent = String(count); });
  };
  updateCartCount();
  window.addEventListener('storage', updateCartCount);
  window.addEventListener('good-apollo:cart-updated', updateCartCount);
</script>

<style>
  .announcement { background: var(--color-brand); color: var(--color-page); text-align: center; font-size: var(--text-xs); letter-spacing: .03em; padding: .58rem var(--space-4); }
  .announcement span { margin-inline: .45rem; color: var(--color-accent); }
  .site-header { display: flex; align-items: center; justify-content: space-between; min-height: 116px; gap: var(--space-8); }
  .header-actions { display: flex; align-items: center; gap: clamp(1.25rem, 3vw, 3rem); }
  .cart-link,.menu-trigger { font-size: var(--text-sm); font-weight: 550; white-space: nowrap; }
  .cart-link { position: relative; text-decoration: none; }
  .cart-link::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -.4rem; height: 1px; background: currentColor; transition: right var(--duration-fast) var(--ease-out); }
  .cart-link:hover::after,.cart-link[aria-current='page']::after { right: 0; }
  .menu-trigger,.menu-close { display: inline-flex; align-items: center; gap: var(--space-3); border: 0; padding: var(--space-3) 0; background: transparent; color: inherit; }
  .menu-icon,.close-icon { position: relative; width: 1.65rem; height: 1rem; display: block; }
  .menu-icon i,.close-icon i { position: absolute; left: 0; width: 100%; height: 1px; background: currentColor; transition: transform var(--duration-gentle) var(--ease-out), top var(--duration-gentle) var(--ease-out); }
  .menu-icon i:first-child { top: .25rem; }
  .menu-icon i:last-child { top: .72rem; width: 72%; left: 28%; }
  .menu-trigger:hover .menu-icon i:first-child { transform: translateX(.2rem); }
  .menu-trigger:hover .menu-icon i:last-child { transform: translateX(-.2rem); }
  :global(html.menu-open) { overflow: hidden; }
  .site-menu { position: fixed; inset: 0; width: 100%; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: var(--color-brand); color: var(--color-page); opacity: 0; transform: translateY(-1.25rem); transition: opacity 360ms var(--ease-out), transform 520ms var(--ease-out), display 360ms allow-discrete, overlay 360ms allow-discrete; }
  .site-menu[open] { opacity: 1; transform: translateY(0); }
  .site-menu.is-closing { opacity: 0; transform: translateY(-1.25rem); }
  .site-menu::backdrop { background: rgb(55 39 47 / .35); }
  @starting-style { .site-menu[open] { opacity: 0; transform: translateY(-1.25rem); } }
  .site-menu :global(.brand-dot) { color: var(--color-accent); }
  .site-menu :focus-visible { outline-color: var(--color-focus-inverse); }
  .menu-shell { min-height: 100dvh; display: flex; flex-direction: column; overflow-y: auto; }
  .menu-header { min-height: 116px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgb(251 248 242 / .2); }
  .menu-close { font-size: var(--text-sm); }
  .close-icon i { top: .5rem; }
  .close-icon i:first-child { transform: rotate(45deg); }
  .close-icon i:last-child { transform: rotate(-45deg); }
  .menu-close:hover .close-icon { transform: rotate(8deg); }
  .menu-body { flex: 1; display: grid; grid-template-columns: minmax(150px, .55fr) minmax(520px, 1.6fr) minmax(170px, .55fr); gap: clamp(2rem, 5vw, 5.5rem); align-items: end; padding-top: clamp(2.5rem, 6vh, 5rem); padding-bottom: clamp(2rem, 5vh, 4rem); }
  .menu-context { align-self: start; padding-top: var(--space-4); }
  .menu-context .eyebrow { color: var(--color-accent); margin-bottom: var(--space-6); }
  .menu-context p:last-child { max-width: 20ch; color: rgb(251 248 242 / .7); font-size: var(--text-sm); line-height: 1.75; }
  .menu-nav { align-self: center; }
  .menu-nav a { display: grid; grid-template-columns: 2.25rem 1fr auto; gap: var(--space-5); align-items: center; min-height: clamp(4.7rem, 9.4vh, 6.5rem); border-bottom: 1px solid rgb(251 248 242 / .22); color: inherit; text-decoration: none; }
  .menu-nav a:first-child { border-top: 1px solid rgb(251 248 242 / .22); }
  .menu-number { align-self: start; padding-top: 1.25rem; color: var(--color-accent); font-size: var(--text-xs); letter-spacing: .08em; }
  .menu-label { font-family: var(--font-display); font-size: clamp(2.15rem, 4.15vw, 4.5rem); font-weight: 430; letter-spacing: -.045em; line-height: .96; transition: color var(--duration-fast), transform var(--duration-gentle) var(--ease-out); }
  .menu-arrow { font-size: var(--text-xl); transition: transform var(--duration-gentle) var(--ease-out), color var(--duration-fast); }
  .menu-nav a:hover .menu-label,.menu-nav a:focus-visible .menu-label { color: var(--color-accent); transform: translateX(.45rem); }
  .menu-nav a:hover .menu-arrow,.menu-nav a:focus-visible .menu-arrow { color: var(--color-accent); transform: translate(.25rem, -.25rem); }
  .menu-nav a[aria-current='page'] .menu-label { color: var(--color-accent); font-style: italic; }
  .menu-meta { display: grid; gap: var(--space-4); align-self: end; font-size: var(--text-sm); }
  .menu-meta a { width: fit-content; text-underline-offset: 5px; }
  .menu-meta p { max-width: 22ch; margin-top: var(--space-6); color: rgb(251 248 242 / .68); line-height: 1.75; }
  @media(max-width: 950px) {
    .menu-body { grid-template-columns: 1fr; align-items: start; }
    .menu-context { display: none; }
    .menu-nav { width: 100%; align-self: start; }
    .menu-meta { grid-template-columns: auto auto; justify-content: start; column-gap: var(--space-8); }
    .menu-meta p { grid-column: 1 / -1; margin-top: var(--space-2); }
  }
  @media(max-width: 600px) {
    .site-header,.menu-header { min-height: 94px; }
    .site-header :global(.brand-name),.menu-header :global(.brand-name) { font-size: 2rem; }
    .site-header :global(.brand-caption),.menu-header :global(.brand-caption) { display: none; }
    .header-actions { gap: var(--space-5); }
    .menu-body { gap: var(--space-8); padding-top: var(--space-6); }
    .menu-nav a { grid-template-columns: 1.75rem 1fr auto; gap: var(--space-3); min-height: 4.65rem; }
    .menu-number { padding-top: 1rem; }
    .menu-label { font-size: clamp(1.95rem, 8vw, 2.75rem); }
  }
  @media(max-width: 390px) { .announcement { font-size: .7rem; } }
</style>
