---
import { publicCatalog } from '../server/catalog';
import ProductCard from './ProductCard.astro';

interface Props {
  kind?: 'hat' | 'all';
  compact?: boolean;
  showEyebrow?: boolean;
  eyebrowText?: string;
  headingText?: string;
}
const {
  compact = false,
  showEyebrow = true,
  eyebrowText = 'The small batch',
  headingText,
} = Astro.props;
let unavailable = false;
const products = await publicCatalog().catch(() => {
  unavailable = true;
  return [];
});
const visibleProducts = products.filter(
  (product) => product.category === 'hat',
);
---

<section
  id="collection"
  class:list={['container collection', { compact }]}
  aria-labelledby="collection-title"
>
  <div class="collection-heading">
    <div>
      {showEyebrow && <p class="eyebrow">{eyebrowText}</p>}
      <h2 id="collection-title" class="display-heading">
        {headingText ?? (compact ? 'From the small batch.' : 'Hats.')}
      </h2>
    </div>
    <p>
      <span>A small, evolving collection.</span>{' '}
      <span>Made slowly in Grand Rapids.</span>
    </p>
  </div>
  <div class="product-grid">
    {visibleProducts.map((product) => (
      <ProductCard product={product} />
    ))}
  </div>
  {!visibleProducts.length && (
    <p>
      {unavailable
        ? 'The collection is temporarily unavailable. Please check back shortly.'
        : 'A new small batch is on its way. Check back for available pieces.'}
    </p>
  )}
  {compact && (
    <a class="text-link shop-all" href="/shop/">
      Shop the collection <span aria-hidden="true">↗</span>
    </a>
  )}
</section>
<style>
  .collection {
    padding-block: var(--space-section);
  }
  .collection.compact {
    padding-top: var(--space-20);
  }
  .collection-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .collection-heading h2 {
    margin-top: var(--space-3);
  }
  .collection-heading > div:not(:has(.eyebrow)) h2 {
    margin-top: 0;
  }
  .collection-heading > p span {
    display: block;
  }
  .collection-heading > p {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.7;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12) var(--space-6);
    margin-top: var(--space-8);
  }
  .shop-all {
    margin-top: var(--space-10);
  }
  @media (min-width: 1000px) {
    .compact .product-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .collection-heading {
      display: block;
    }
    .collection-heading > p span {
      display: block;
    }
    .collection-heading > p {
      margin-top: var(--space-5);
    }
    .collection-heading br {
      display: none;
    }
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
