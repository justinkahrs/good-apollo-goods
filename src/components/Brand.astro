---
interface Props { large?: boolean; }
const { large = false } = Astro.props;
const lockup = large ? '/brand/gag-stacked-lockup.svg' : '/brand/gag-lockup.svg';
---
<a href="/" class:list={['brand', { 'brand--stacked': large }]} aria-label="Good Apollo Goods home">
  <img src={lockup} alt="Good Apollo Goods" />
</a>

<style>
  .brand { display: inline-flex; width: 12.5rem; text-decoration: none; }
  .brand img { display: block; width: 100%; height: auto; }
  .brand--stacked { width: clamp(9.5rem, 15vw, 13.5rem); }

  @media (max-width: 480px) {
    .brand { width: 10rem; }
    .brand--stacked { width: 11rem; }
  }
</style>
